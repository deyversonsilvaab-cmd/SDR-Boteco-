# Chave da OpenAI (OBRIGATÓRIA) - pegue em https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Modelo principal (opcional) - padrão: gpt-5.6-luna (OpenAI Responses API)
OPENAI_MODEL=gpt-5.6-luna

# Modelo de fallback (opcional) - padrão: gpt-4o
OPENAI_FALLBACK_MODEL=gpt-4o

# Segredo do webhook (opcional, recomendado) - protege o endpoint de chamadas não autorizadas
WEBHOOK_SECRET=

# Nome do negócio (opcional) - usado só se a base de conhecimento não carregar
BUSINESS_NAME=Sr. Boteco Limeira

# v2.12.0 — Modo humano. Deixe VAZIO durante a ativação gradual: o ManyChat liga por contato com "modo_humano": true.
# Use "on" só para ligar para TODOS os contatos (ativação final).
HUMAN_TONE=

# v2.12.0 — Orçamento TOTAL de tempo da IA por mensagem, em milissegundos (todas as tentativas somadas). Padrão: 6500.
# O External Request do ManyChat desiste em cerca de 10 s, então não suba muito esse valor.
AI_BUDGET_MS=6500
